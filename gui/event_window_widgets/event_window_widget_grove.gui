vbox = {
	name = "event_window_widget_grove"
	layoutpolicy_horizontal = expanding
	margin = { 10 10 }

	datacontext = "[EventWindowWidget.GetScope.sC('scope_character')]"

	divider_light = {
		layoutpolicy_horizontal = expanding
	}

	hbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		icon = {
			name = "mahdi_failure_icon"
			size = { 50 50 }
			framesize = { 70 70 }
			texture = "gfx/interface/icons/terrain_types/jungle.dds"
			tooltip = "ck_mahdi_grove_success_icon_tt"
			visible = "[GetScriptedGui('mahdi_grove_failure').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
		}
		icon = {
			name = "mahdi_success_icon"
			size = { 50 50 }
			framesize = { 70 70 }
			texture = "gfx/interface/icons/terrain_types/oasis.dds"
			tooltip = "ck_mahdi_grove_success_icon_tt"
			visible = "[GetScriptedGui('mahdi_grove_success').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
		}
		
		text_single = {
			name = "grove_text"
			margin = { 20 0 }
			text = event_window_widget_grove
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			autoresize = yes
		}
	}
}