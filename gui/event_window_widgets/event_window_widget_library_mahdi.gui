vbox = {
	name = "event_window_widget_library_mahdi"
	layoutpolicy_horizontal = expanding
	margin = { 0 0 }

	datacontext = "[EventWindowWidget.GetScope.sC('scope_character')]"
	
	text_single = {
		name = "mahdi_library_text"
		margin = { 20 10 }
		text = "west_nahasa.0003.books_read"
		default_format = "#weak"
		align = nobaseline
	}
	background = {
		using = Background_Area_Dark
		using = Mask_Rough_Edges
		alpha = 0.5
		margin_bottom = 5
	}


	
}